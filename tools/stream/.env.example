# Copy this file to .env (in this same folder) and fill in your key. Never commit .env.
YOUTUBE_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Walt Disney World (index.html) or Disneyland (disneyland.html)
PAGE=index.html
# empty = all parks; or mk, ep, hs, ak (Walt Disney World) / mk, ep (Disneyland = Disneyland Park, California Adventure)
TV_PARK=

# off = sound effects only (recommended: YouTube's Content ID catches Disney's music); on = soundtracks too
MUSIC=off

# picture: 1920x1080 needs about 4 CPU cores; 1280x720 about 2
WIDTH=1920
HEIGHT=1080
FPS=30
VIDEO_BITRATE=4500k
AUDIO_BITRATE=160k
# slower presets look better but need more CPU: ultrafast, superfast, veryfast, faster
X264_PRESET=veryfast

# the park's time zone, so the clock and day/night match Orlando (America/Los_Angeles for Disneyland)
TZ=America/New_York
